    "nomeProduto": { "type": "string" },
    "pedido": { "type": "relation", "relation": "manyToOne", "target": "api::pedido.pedido", "inversedBy": "itens" },
    "produto": { "type": "relation", "relation": "manyToOne", "target": "api::produto.produto" }
  }
}
